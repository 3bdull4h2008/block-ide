{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cade",
  "version": "0.1.0",
  "identifier": "com.blockide.dev",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build && npm run copytcc"
  },
  "app": {
    "windows": [
      {
        "title": "Cade",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "resources/tcc/": "tcc/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}

